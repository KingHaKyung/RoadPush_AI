{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpush.local/schemas/passability-result-v2.json",
  "title": "PassabilityResultV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "selected_surface",
    "phase7a_policy_id",
    "phase7a_status",
    "result_authority",
    "measurement_scope",
    "measurement_confidence",
    "human_review_required",
    "abstention_reasons",
    "minimum_passable_ratio",
    "raw_minimum_passable_ratio",
    "maximum_obstructed_width_ratio",
    "obstacle_area_ratio",
    "bottleneck",
    "selected_corridor_path",
    "maximum_obstruction",
    "surface_width_m",
    "absolute_passable_width_m",
    "effective_blocked_width_m",
    "agent_width_m",
    "safety_factor",
    "required_safe_width_m",
    "required_passable_ratio",
    "required_safe_ratio",
    "passability_state",
    "flags",
    "diagnostics"
  ],
  "properties": {
    "schema_version": { "const": "phase7_b_result_v2" },
    "sample_id": { "type": "string", "minLength": 1 },
    "selected_surface": { "type": ["string", "null"] },
    "phase7a_policy_id": { "type": "string", "minLength": 1 },
    "phase7a_status": {
      "enum": ["selected", "unchanged", "selected_partial", "ambiguous_hold", "failed"]
    },
    "result_authority": {
      "enum": ["authoritative", "provisional_review", "none"]
    },
    "measurement_scope": {
      "enum": ["full", "partial", "provisional", "none"]
    },
    "measurement_confidence": {
      "enum": ["reliable", "low", "insufficient"]
    },
    "human_review_required": { "type": "boolean" },
    "abstention_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "minimum_passable_ratio": { "$ref": "#/$defs/nullable_ratio" },
    "raw_minimum_passable_ratio": { "$ref": "#/$defs/nullable_ratio" },
    "maximum_obstructed_width_ratio": { "$ref": "#/$defs/nullable_ratio" },
    "obstacle_area_ratio": { "$ref": "#/$defs/nullable_ratio" },
    "bottleneck": { "type": ["object", "null"] },
    "selected_corridor_path": { "type": "array" },
    "maximum_obstruction": { "type": ["object", "null"] },
    "surface_width_m": { "$ref": "#/$defs/nullable_positive" },
    "absolute_passable_width_m": { "$ref": "#/$defs/nullable_nonnegative" },
    "effective_blocked_width_m": { "$ref": "#/$defs/nullable_nonnegative" },
    "agent_width_m": { "$ref": "#/$defs/nullable_positive" },
    "safety_factor": {
      "type": ["number", "null"],
      "minimum": 1
    },
    "required_safe_width_m": { "$ref": "#/$defs/nullable_positive" },
    "required_passable_ratio": { "$ref": "#/$defs/nullable_nonnegative" },
    "required_safe_ratio": { "$ref": "#/$defs/nullable_nonnegative" },
    "passability_state": {
      "enum": ["undetermined", "relative_only", "blocked", "narrowed", "passable"]
    },
    "flags": { "type": "array", "items": { "type": "string" } },
    "diagnostics": { "type": "object" }
  },
  "$defs": {
    "nullable_ratio": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "nullable_positive": {
      "type": ["number", "null"],
      "exclusiveMinimum": 0
    },
    "nullable_nonnegative": {
      "type": ["number", "null"],
      "minimum": 0
    }
  }
}
