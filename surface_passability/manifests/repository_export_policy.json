{
  "schema_version": "2.0",
  "destination": "KingHaKyung/RoadPush_AI",
  "strategy": "allowlisted integrated production overlay",
  "include": [
    ".gitignore",
    "README.md",
    "setup.bat",
    "pyproject.toml",
    "configs/*.yaml",
    "requirements/*.txt",
    "schemas/*.json",
    "src/roadpush_ai/**/*.py",
    "docs/PRODUCTION_SYSTEM.md",
    "docs/DEVELOPMENT_HISTORY.md",
    "surface_passability/pyproject.toml",
    "surface_passability/requirements/*.txt",
    "surface_passability/schemas/*.json",
    "surface_passability/manifests/*.json",
    "surface_passability/src/surface_passability/**/*.py",
    "obstacle_yolo/README.md",
    "obstacle_yolo/requirements.txt",
    "obstacle_yolo/service/README.md",
    "obstacle_yolo/service/config.yaml",
    "obstacle_yolo/service/predict.py",
    "obstacle_yolo/service/attach_cause.py"
  ],
  "exclude_from_git": [
    "MIGRATION.md",
    "migration_work/**",
    "tests/**",
    "experiments/**",
    "models/**",
    "data/**",
    "outputs/**",
    "artifacts/**",
    "surface_passability/tests/**",
    "obstacle_yolo/scripts/**",
    "obstacle_yolo/weights/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.pytest_cache/**",
    "**/*.egg-info/**"
  ],
  "team_repro_zip_additions": [
    "models/**",
    "experiments/surface_passability/reproducibility/full160/inputs/**",
    "experiments/surface_passability/reproducibility/full160/expected/**",
    "experiments/surface_passability/reproducibility/full160/input_manifest.json"
  ],
  "team_repro_zip_exclusions": [
    "MIGRATION.md",
    "migration_work/**",
    "tests/**",
    "experiments/integration/**",
    "experiments/**/tests/**",
    "experiments/**/*.py",
    "experiments/**/work/**",
    "experiments/**/outputs/**",
    "experiments/**/cache*/**",
    ".git/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "**/.pytest_cache/**",
    "**/*.egg-info/**"
  ],
  "organization_push_requires_user_approval": true
}
