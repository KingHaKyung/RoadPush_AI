{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roadpush.local/schema/analyze-request-v1.json",
  "title": "RoadPushAnalyzeRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "sample_id",
    "image_uri",
    "image_content_sha256",
    "input_profile"
  ],
  "properties": {
    "request_id": { "type": "string", "minLength": 1 },
    "sample_id": { "type": "string", "minLength": 1 },
    "image_uri": { "type": "string", "minLength": 1 },
    "image_content_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "input_profile": { "enum": ["image_upload", "cctv"] },
    "surface_width_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "agent_width_m": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "safety_factor": { "type": ["number", "null"], "minimum": 1 },
    "render_review": { "type": "boolean", "default": false }
  }
}

